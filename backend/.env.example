# ===========================
# BHU Email Portal — Backend Environment Variables
# Copy this file to .env and fill in the values
# ===========================

# --- Database (PostgreSQL via Docker Compose) ---
DATABASE_URL="postgresql://bhu_admin:bhu_secure_password_2024@localhost:5432/bhu_email_portal?schema=public"

# --- JWT Authentication ---
JWT_ACCESS_SECRET="change-me-access-secret-2024"
JWT_REFRESH_SECRET="change-me-refresh-secret-2024"
JWT_ACCESS_EXPIRY_SECONDS=900        # 15 minutes
JWT_REFRESH_EXPIRY_SECONDS=604800    # 7 days

# --- Server ---
PORT=4000
FRONTEND_URL="http://localhost:3000"

# --- Google Workspace Admin SDK ---
# Set MOCK_GOOGLE_WORKSPACE=true for local development without real credentials
MOCK_GOOGLE_WORKSPACE=true
GOOGLE_CLIENT_EMAIL="service-account@bhu-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_ADMIN_EMAIL="admin@bhu.ac.in"
GOOGLE_DOMAIN="bhu.ac.in"

# --- Email / SMTP (Nodemailer) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@bhu.ac.in"
SMTP_PASS="your-smtp-password"

# --- File Uploads ---
UPLOAD_DIR="./uploads"
MAX_PHOTO_SIZE_MB=2

# --- Docker Compose (used by docker-compose.yml) ---
POSTGRES_USER=bhu_admin
POSTGRES_PASSWORD=bhu_secure_password_2024
POSTGRES_DB=bhu_email_portal
PGADMIN_EMAIL=admin@bhu.ac.in
PGADMIN_PASSWORD=admin123

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=10
