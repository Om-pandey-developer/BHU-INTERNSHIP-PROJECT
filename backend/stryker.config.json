{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/modules/mail/mail.service.ts",
    "src/modules/google-workspace/google-workspace.service.ts"
  ],
  "testRunner": "jest",
  "reporters": [
    "progress",
